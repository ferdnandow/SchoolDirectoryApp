@page "/schools"
@rendermode InteractiveServer
@using SchoolDirectoryApp.Models
@using SchoolDirectoryApp.Services
@inject SchoolService schoolService

<PageTitle>Schools</PageTitle>

<h1>School Directory</h1>

<button class="btn btn-primary mb-3" @onclick="Refresh">Refresh</button>
<button class="btn btn-secondary mb-3" @onclick="() => sortAsc = !sortAsc">
    @(sortAsc ? "Sort Z-A" : "Sort A-Z")
</button>


@if (error)
{
    <p class="text-danger">Unable to retrieve school data.</p>
}
else if (schools == null)
{
    <p>Loading schools...</p>
}
else
{
    <input @bind="Search"
           @bind:event="oninput"
           class="form-control mb-3"
           placeholder="Search school..." />

    <div class="row">
        <div class="col-md-6">
            @if (filtered.Count == 0)
            {
                <p>No schools found.</p>
            }
            else
            {
                @foreach (var school in filtered)
                {
                    <SchoolCard School="school"
                                IsFavourite="favourites.Contains(school.SchoolId)"
                                OnSelect="SelectSchool"
                                OnFavourite="ToggleFavourite" />
                }
            }
        </div>

        <div class="col-md-6">
            @if (selected == null)
            {
                <p>Select a school to see the details.</p>
            }
            else
            {
                <SchoolDetails School="selected" />
            }
        </div>
    </div>
}

@code {
    private List<School>? schools;
    private School? selected;
    private bool error;
    private string Search { get; set; } = "";

    private bool sortAsc = true;

    private List<School> filtered
    {
        get
        {
            if (schools == null)
                return new List<School>();

            var result = schools.Where(s => s.SchoolName.Contains(Search, StringComparison.OrdinalIgnoreCase));

            if (sortAsc)
                return result.OrderBy(s => s.SchoolName).ToList();

            return result.OrderByDescending(s => s.SchoolName).ToList();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadSchools();
    }

    private async Task LoadSchools()
    {
        try
        {
            schools = await schoolService.GetSchools();
        }
        catch
        {
            error = true;
        }
    }

    private async Task Refresh()
    {
        schools = null;
        selected = null;
        error = false;
        await LoadSchools();
    }

    private void SelectSchool(School school)
    {
        selected = school;
    }
    
    private List<int> favourites = new List<int>();

    private void ToggleFavourite(School school)
    {
        if (favourites.Contains(school.SchoolId))
            favourites.Remove(school.SchoolId);
        else
            favourites.Add(school.SchoolId);
    }
}